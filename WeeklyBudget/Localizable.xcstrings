    "Add expenses on the Week tab and they roll up here.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف المصروفات في تبويب الأسبوع وستُجمع هنا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trag Ausgaben im Tab Woche ein, hier werden sie zusammengefasst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade gastos en la pestaña Semana y aquí se resumen."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrega gastos en la pestaña Semana y aquí se resumen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez des dépenses dans l'onglet Semaine et elles se cumulent ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सप्ताह टैब में खर्च जोड़ें, यहाँ उनका जोड़ दिखेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan pengeluaran di tab Minggu, di sini akan dijumlahkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi spese nella scheda Settimana e qui vengono riepilogate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「週」タブで支出を追加すると、ここに合計が出ます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주 탭에서 지출을 추가하면 여기에 합산돼요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg uitgaven toe op het tabblad Week; hier worden ze opgeteld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodawaj wydatki w zakładce Tydzień, a tutaj się zsumują."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lance gastos na aba Semana e eles se somam aqui."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Registe despesas no separador Semana e elas somam-se aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляй расходы на вкладке «Неделя» — здесь они суммируются."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Harcamaları Hafta sekmesinde ekle, burada toplanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додавай витрати на вкладці «Тиждень» — тут вони підсумовуються."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm khoản chi ở tab Tuần, ở đây sẽ cộng lại."
          }
        },
        "zh-Hans": {
