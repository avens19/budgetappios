    "Create one while adding an expense and it will appear here.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنشئ واحدة أثناء إضافة مصروف وستظهر هنا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg beim Eintragen einer Ausgabe eine an, dann steht sie hier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una al añadir un gasto y aparecerá aquí."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una al agregar un gasto y va a aparecer aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez-en une en ajoutant une dépense et elle apparaîtra ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खर्च जोड़ते समय एक बनाएँ, वह यहाँ आ जाएगी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buat satu saat menambah pengeluaran, nanti muncul di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Creane una mentre aggiungi una spesa e comparirà qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "支出の追加時に作成すると、ここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지출을 추가할 때 만들면 여기에 나타나요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak er een terwijl je een uitgave toevoegt, dan staat hij hier."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utwórz ją przy dodawaniu wydatku, a znajdzie się tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie uma ao lançar um gasto e ela aparece aqui."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie uma ao registar uma despesa e ela aparece aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создай её при добавлении расхода, и она появится здесь."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Harcama eklerken bir tane oluştur, burada görünsün."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Створи її під час додавання витрати, і вона з'явиться тут."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
