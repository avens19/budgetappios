    "Could not cancel that invitation.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر إلغاء تلك الدعوة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einladung konnte nicht zurückgezogen werden."
          }
        },
        "es": {
