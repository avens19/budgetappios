    "Add an expense on any of them and the rest catch up within seconds.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف مصروفًا على أي منها وتلحق البقية خلال ثوانٍ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trag auf einem davon eine Ausgabe ein, und der Rest zieht in Sekunden nach."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un gasto en cualquiera de ellos y los demás se ponen al día en segundos."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrega un gasto en cualquiera de ellos y los demás se ponen al día en segundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez une dépense sur l'un d'eux et les autres se mettent à jour en quelques secondes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इनमें से किसी पर भी खर्च जोड़ें, बाकी कुछ ही सेकंड में मिल जाते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Catat pengeluaran di salah satunya dan yang lain menyusul dalam hitungan detik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi una spesa su uno qualsiasi e gli altri si allineano in pochi secondi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どれかで支出を追加すれば、残りも数秒で追いつきます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어느 쪽에서든 지출을 추가하면 나머지도 몇 초 안에 따라와요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg op een ervan een uitgave toe en de rest loopt binnen seconden bij."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj wydatek na dowolnym z nich, a reszta nadrobi w kilka sekund."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lance um gasto em qualquer um deles e os outros se atualizam em segundos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Registe uma despesa em qualquer um deles e os restantes atualizam-se em segundos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавь расход на любом из них, и остальные подтянутся за секунды."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Herhangi birine bir harcama ekle, diğerleri saniyeler içinde yetişir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додай витрату на будь-якому з них, і решта підтягнеться за секунди."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi một khoản chi ở bất kỳ cái nào, những cái còn lại bắt kịp trong vài giây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在其中任意一个记一笔，其余的几秒钟就跟上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在其中任一個記一筆，其餘的幾秒鐘就跟上。"
          }
        }
      }
    },
