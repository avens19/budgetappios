    "Good for one use, for the next seven days. Cancel it if you send it to the wrong person.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صالح لاستخدام واحد خلال سبعة أيام. ألغِه إذا أرسلته إلى الشخص الخطأ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt einmal, sieben Tage lang. Zieh ihn zurück, wenn er beim Falschen gelandet ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vale para un solo uso durante siete días. Cancélalo si se lo envías a quien no era."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Sirve para un solo uso durante siete días. Cancélalo si se lo mandas a la persona equivocada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Valable une fois, pendant sept jours. Annulez-le si vous l'envoyez à la mauvaise personne."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सात दिन तक एक बार इस्तेमाल के लिए। गलत व्यक्ति को भेज दें तो इसे रद्द कर दें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berlaku sekali pakai selama tujuh hari. Batalkan kalau salah kirim orang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vale un solo utilizzo, per sette giorni. Annullalo se lo mandi alla persona sbagliata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "7日間、1回だけ有効です。送る相手を間違えたら取り消してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "7일 동안 한 번만 쓸 수 있어요. 엉뚱한 사람에게 보냈다면 취소하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén keer te gebruiken, zeven dagen lang. Trek hem in als je hem naar de verkeerde stuurt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ważny raz, przez siedem dni. Anuluj go, jeśli trafi do niewłaściwej osoby."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vale para um uso, por sete dias. Cancele se mandar para a pessoa errada."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Válida para uma utilização, durante sete dias. Cancele-a se a enviar à pessoa errada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Действует один раз, семь дней. Отзовите её, если отправили не тому человеку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yedi gün boyunca tek kullanımlık. Yanlış kişiye gönderdiysen iptal et."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Діє один раз, сім днів. Відкличте його, якщо надіслали не тій людині."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng được một lần, trong bảy ngày. Huỷ nếu bạn gửi nhầm người."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "七天内可用一次。发错人就取消它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "七天內可用一次。傳錯人就取消它。"
          }
        }
      }
    },
