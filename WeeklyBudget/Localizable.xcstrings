    "What actually lands in the account, after tax and deductions.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما يصل فعلًا إلى الحساب، بعد الضرائب والاستقطاعات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was tatsächlich auf dem Konto landet, nach Steuern und Abzügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que llega de verdad a la cuenta, después de impuestos y retenciones."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que de verdad llega a la cuenta, después de impuestos y descuentos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui arrive vraiment sur le compte, après impôts et cotisations."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टैक्स और कटौतियों के बाद खाते में सचमुच जो आता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Yang benar-benar masuk ke rekening, setelah pajak dan potongan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quello che arriva davvero sul conto, al netto di tasse e trattenute."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "税金や控除を引いて、実際に口座に入る金額です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세금과 공제를 뺀 뒤 실제로 계좌에 들어오는 금액이에요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat er echt op de rekening staat, na belasting en inhoudingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To, co naprawdę trafia na konto, po podatkach i składkach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que realmente cai na conta, depois de impostos e descontos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O que entra mesmo na conta, depois de impostos e descontos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "То, что реально попадает на счёт, после налогов и удержаний."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergi ve kesintilerden sonra hesaba gerçekten geçen tutar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Те, що справді потрапляє на рахунок, після податків і утримань."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Số thực sự về tài khoản, sau thuế và các khoản trừ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扣完税和各项之后，真正到账的金额。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "扣完稅和各項之後，真正入帳的金額。"
          }
        }
      }
    },
    "What you can spend in a week, after the bills that never change.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما يمكنك إنفاقه في أسبوع، بعد الفواتير التي لا تتغير."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was du in einer Woche ausgeben kannst, nach den Rechnungen, die sich nie ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que puedes gastar en una semana, después de las facturas que nunca cambian."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que puedes gastar en una semana, después de las cuentas que nunca cambian."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que vous pouvez dépenser en une semaine, une fois retirées les factures qui ne changent jamais."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उन बिलों के बाद जो कभी नहीं बदलते, आप एक हफ्ते में कितना खर्च कर सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Yang bisa kamu belanjakan dalam seminggu, setelah tagihan yang tidak pernah berubah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quello che puoi spendere in una settimana, tolte le spese fisse che non cambiano mai."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎月変わらない支払いを引いたあと、1週間に使える金額です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변하지 않는 지출을 뺀 뒤, 한 주에 쓸 수 있는 금액이에요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat je in een week kunt uitgeven, na de vaste lasten die nooit veranderen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ile możesz wydać w tygodniu po rachunkach, które się nie zmieniają."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que você pode gastar em uma semana, depois das contas que nunca mudam."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O que pode gastar numa semana, depois das contas que nunca mudam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сколько можно тратить за неделю после платежей, которые не меняются."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiç değişmeyen faturalardan sonra bir haftada harcayabileceğin tutar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скільки можна витрачати за тиждень після платежів, які не змінюються."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Số tiền bạn được tiêu trong một tuần, sau những khoản không bao giờ đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扣掉每月不变的账单之后，你一周可以花的钱。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "扣掉每月不變的帳單之後，你一週可以花的錢。"
          }
        }
      }
    },
