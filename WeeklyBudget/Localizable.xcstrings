            "state": "translated",
            "value": "वह न्योता रद्द नहीं हो सका।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Undangan itu gagal dibatalkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile annullare quell'invito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その招待を取り消せませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 초대를 취소하지 못했어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Die uitnodiging kon niet ingetrokken worden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się anulować tego zaproszenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível cancelar esse convite."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível cancelar esse convite."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось отозвать это приглашение."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu davet iptal edilemedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося відкликати це запрошення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không huỷ được lời mời đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消那个邀请失败。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取消那個邀請失敗。"
          }
        }
      }
    },
    "Could not create an invitation. Check your connection and try again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر إنشاء الدعوة. تحقق من اتصالك وحاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einladung konnte nicht erstellt werden. Prüf deine Verbindung und versuch es nochmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido crear la invitación. Comprueba la conexión e inténtalo de nuevo."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo crear la invitación. Revisa tu conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de créer l'invitation. Vérifiez votre connexion et réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "न्योता नहीं बन सका। अपना कनेक्शन देखें और फिर कोशिश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Undangan gagal dibuat. Periksa koneksimu dan coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile creare l'invito. Controlla la connessione e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "招待を作成できませんでした。通信状況を確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초대를 만들지 못했어요. 연결 상태를 확인하고 다시 시도해 주세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De uitnodiging kon niet gemaakt worden. Controleer je verbinding en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się utworzyć zaproszenia. Sprawdź połączenie i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível criar o convite. Verifique sua conexão e tente de novo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível criar o convite. Verifique a ligação e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось создать приглашение. Проверь соединение и попробуй ещё раз."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Davet oluşturulamadı. Bağlantını kontrol et ve tekrar dene."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося створити запрошення. Перевір з'єднання і спробуй ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tạo được lời mời. Kiểm tra kết nối rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "邀请创建失败。检查网络连接后再试一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "建立邀請失敗。檢查網路連線後再試一次。"
          }
        }
      }
    },
