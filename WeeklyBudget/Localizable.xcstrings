        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Compila quello che puoi. Il numero si aggiorna mentre scrivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "分かる範囲で入力してください。入力に合わせて数字が変わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아는 만큼 채워 보세요. 입력할 때마다 숫자가 바뀌어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vul in wat je kunt. Het getal verandert terwijl je typt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wypełnij, co możesz. Liczba zmienia się w trakcie pisania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Preencha o que puder. O número muda enquanto você digita."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Preencha o que puder. O número atualiza-se enquanto escreve."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заполни, что можешь. Число меняется по мере ввода."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doldurabildiğini doldur. Sayı sen yazdıkça güncellenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Заповни, що можеш. Число змінюється, поки ти вводиш."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điền được bao nhiêu thì điền. Con số đổi theo lúc bạn gõ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "能填的先填。数字会随着你输入而变化。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "能填的先填。數字會隨著你輸入而變動。"
          }
        }
      }
    },
    "Fits more on screen: one running list for the week instead of a heading per day, and a smaller balance strip.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتسع أكثر على الشاشة: قائمة واحدة متصلة للأسبوع بدل عنوان لكل يوم، وشريط رصيد أصغر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passt mehr auf den Bildschirm: eine durchgehende Liste für die Woche statt einer Überschrift pro Tag, und ein schmalerer Saldostreifen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cabe más en pantalla: una sola lista continua para la semana en vez de un encabezado por día, y una franja de saldo más pequeña."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Cabe más en pantalla: una sola lista continua para la semana en vez de un encabezado por día, y una franja de saldo más chica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus de choses à l'écran : une seule liste continue pour la semaine au lieu d'un titre par jour, et un bandeau de solde plus petit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्क्रीन पर ज़्यादा आता है: हर दिन के शीर्षक की जगह पूरे सप्ताह की एक चलती सूची, और छोटी बैलेंस पट्टी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Muat lebih banyak di layar: satu daftar berjalan untuk seminggu, bukan judul tiap hari, dan bilah saldo yang lebih kecil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ci sta di più sullo schermo: un'unica lista continua per la settimana invece di un titolo al giorno, e una fascia del saldo più piccola."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面に多く収まります。日ごとの見出しではなく週をひと続きのリストにして、残高の帯も小さくします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면에 더 많이 들어가요. 날짜별 제목 대신 한 주를 이어지는 목록 하나로 보여주고, 잔액 띠도 작아져요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Past meer op het scherm: één doorlopende lijst voor de week in plaats van een kop per dag, en een smallere saldobalk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mieści się więcej: jedna ciągła lista na tydzień zamiast nagłówka na każdy dzień i węższy pasek salda."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cabe mais na tela: uma lista corrida para a semana em vez de um título por dia, e uma faixa de saldo menor."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cabe mais no ecrã: uma lista corrida para a semana em vez de um título por dia, e uma faixa de saldo mais pequena."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Помещается больше: один сплошной список за неделю вместо заголовка на каждый день и более узкая полоса остатка."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekrana daha çok sığar: her güne bir başlık yerine hafta için tek bir akan liste ve daha ince bir bakiye şeridi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вміщується більше: один суцільний список за тиждень замість заголовка на кожен день і вужча смуга залишку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện được nhiều hơn: một danh sách liền mạch cho cả tuần thay vì mỗi ngày một tiêu đề, và dải số dư nhỏ hơn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕上能放下更多：一整周用一条连续的列表，而不是每天一个标题，余额条也更窄。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "螢幕上能放下更多：整週用一條連續的清單，而不是每天一個標題，餘額列也更窄。"
          }
        }
      }
    },
