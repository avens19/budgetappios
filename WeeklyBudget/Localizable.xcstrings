    "Once you tag expenses with a category, the breakdown appears here.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بمجرد وضع فئات للمصروفات سيظهر التوزيع هنا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobald Ausgaben eine Kategorie haben, erscheint hier die Aufteilung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando etiquetes gastos con una categoría, el desglose aparecerá aquí."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando etiquetes gastos con una categoría, el desglose aparece aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dès que vos dépenses portent une catégorie, la répartition apparaît ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जैसे ही खर्चों पर श्रेणी लगेगी, यहाँ बँटवारा दिखेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Begitu pengeluaran punya kategori, rinciannya muncul di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando assegni una categoria alle spese, qui compare la suddivisione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "支出にカテゴリを付けると、ここに内訳が出ます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지출에 카테고리를 붙이면 여기에 분포가 나와요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zodra je uitgaven een categorie geeft, verschijnt de verdeling hier."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy wydatki dostaną kategorie, pojawi się tu podział."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois de marcar gastos com uma categoria, a divisão aparece aqui."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Assim que marcar despesas com uma categoria, a repartição aparece aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как только у расходов появятся категории, здесь будет разбивка."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Harcamalara kategori verdiğinde dağılım burada belirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щойно витрати отримають категорії, тут з'явиться розподіл."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi các khoản chi có danh mục, tỷ lệ sẽ hiện ở đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "给支出加上分类后，这里会显示占比。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "幫支出加上分類後，這裡會顯示比例。"
          }
        }
      }
    },
    "One budget can live on as many devices as you like, and they all stay in step.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن للميزانية الواحدة أن تعيش على أي عدد من الأجهزة، وتبقى كلها متطابقة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Budget kann auf beliebig vielen Geräten liegen, und alle bleiben synchron."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un presupuesto puede vivir en tantos dispositivos como quieras, y todos se mantienen sincronizados."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Un presupuesto puede vivir en todos los dispositivos que quieras, y todos se mantienen sincronizados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un budget peut vivre sur autant d'appareils que vous voulez, et ils restent tous synchronisés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक बजट जितने चाहें उतने डिवाइस पर रह सकता है, और सब एक जैसे रहते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu anggaran bisa hidup di sebanyak apa pun perangkat, dan semuanya tetap sama."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un budget può stare su quanti dispositivi vuoi, e restano tutti allineati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1つの予算は好きなだけ端末に置けて、すべて同じ状態に保たれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하나의 예산을 원하는 만큼 많은 기기에 둘 수 있고, 모두 같은 상태로 유지돼요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén budget kan op zoveel apparaten staan als je wilt, en ze blijven allemaal gelijk lopen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden budżet może być na dowolnej liczbie urządzeń i wszystkie pozostają zgodne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um orçamento pode viver em quantos dispositivos você quiser, e todos ficam sincronizados."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um orçamento pode viver em tantos dispositivos quantos quiser, e todos ficam sincronizados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один бюджет может жить на любом числе устройств, и все они остаются в согласии."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir bütçe istediğin kadar cihazda yaşayabilir ve hepsi aynı kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Один бюджет може жити на будь-якій кількості пристроїв, і всі вони лишаються узгодженими."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một ngân sách có thể nằm trên bao nhiêu thiết bị tuỳ bạn, và tất cả luôn khớp nhau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个预算可以放在任意多台设备上，而且始终保持一致。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一個預算可以放在任意多台裝置上，而且始終保持一致。"
          }
        }
      }
    },
    "One budget can live on as many devices as you like, and they all stay in step. Open Settings, create an invitation, and send the link — whoever opens it joins this budget.\n\nThe link works once and expires after a week, so a forwarded one is harmless.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن للميزانية الواحدة أن تعيش على أي عدد من الأجهزة، وتبقى كلها متطابقة. افتح الإعدادات، وأنشئ دعوة، وأرسل الرابط — من يفتحه ينضم إلى هذه الميزانية.\n\nالرابط يعمل مرة واحدة وتنتهي صلاحيته بعد أسبوع، فإعادة إرساله غير ضارة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Budget kann auf beliebig vielen Geräten liegen, und alle bleiben synchron. Öffne die Einstellungen, erstelle eine Einladung und schick den Link — wer ihn öffnet, tritt diesem Budget bei.\n\nDer Link gilt einmal und läuft nach einer Woche ab, weitergeleitet richtet er also keinen Schaden an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un presupuesto puede vivir en tantos dispositivos como quieras, y todos se mantienen sincronizados. Abre Ajustes, crea una invitación y envía el enlace: quien lo abra se une a este presupuesto.\n\nEl enlace funciona una sola vez y caduca en una semana, así que reenviarlo es inofensivo."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Un presupuesto puede vivir en todos los dispositivos que quieras, y todos se mantienen sincronizados. Abre Ajustes, crea una invitación y manda el enlace: quien lo abra se une a este presupuesto.\n\nEl enlace sirve una sola vez y vence en una semana, así que reenviarlo no hace daño."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un budget peut vivre sur autant d'appareils que vous voulez, et ils restent tous synchronisés. Ouvrez Réglages, créez une invitation et envoyez le lien — celui qui l'ouvre rejoint ce budget.\n\nLe lien ne sert qu'une fois et expire au bout d'une semaine : le transférer est sans risque."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक बजट जितने चाहें उतने डिवाइस पर रह सकता है, और सब एक जैसे रहते हैं। सेटिंग खोलें, न्योता बनाएँ और लिंक भेजें — जो उसे खोलेगा वह इसी बजट में जुड़ जाएगा।\n\nलिंक एक ही बार चलता है और एक हफ्ते में खत्म हो जाता है, इसलिए आगे भेजने में कोई नुकसान नहीं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu anggaran bisa hidup di sebanyak apa pun perangkat, dan semuanya tetap sama. Buka Pengaturan, buat undangan, lalu kirim tautannya — siapa pun yang membukanya ikut ke anggaran ini.\n\nTautan hanya berlaku sekali dan kedaluwarsa setelah seminggu, jadi kalau diteruskan pun tidak masalah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un budget può stare su quanti dispositivi vuoi, e restano tutti allineati. Apri Impostazioni, crea un invito e manda il link — chi lo apre entra in questo budget.\n\nIl link vale una volta sola e scade dopo una settimana, quindi inoltrarlo non fa danni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1つの予算は好きなだけ端末に置けて、すべて同じ状態に保たれます。設定を開いて招待を作り、リンクを送ってください。開いた相手はこの予算に参加します。\n\nリンクは1回だけ有効で1週間で失効するので、転送されても問題ありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하나의 예산을 원하는 만큼 많은 기기에 둘 수 있고, 모두 같은 상태로 유지돼요. 설정을 열고 초대를 만든 뒤 링크를 보내세요. 링크를 연 사람이 이 예산에 참여해요.\n\n링크는 한 번만 쓸 수 있고 일주일 뒤 만료되니 전달돼도 괜찮아요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén budget kan op zoveel apparaten staan als je wilt, en ze blijven allemaal gelijk lopen. Open Instellingen, maak een uitnodiging en stuur de link — wie hem opent doet mee met dit budget.\n\nDe link werkt één keer en verloopt na een week, dus doorsturen kan geen kwaad."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden budżet może być na dowolnej liczbie urządzeń i wszystkie pozostają zgodne. Otwórz Ustawienia, utwórz zaproszenie i wyślij link — kto go otworzy, dołącza do tego budżetu.\n\nLink działa raz i wygasa po tygodniu, więc przesłanie go dalej nic nie psuje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um orçamento pode viver em quantos dispositivos você quiser, e todos ficam sincronizados. Abra Configurações, crie um convite e mande o link — quem abrir entra neste orçamento.\n\nO link funciona uma vez só e expira em uma semana, então repassá-lo não faz mal."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um orçamento pode viver em tantos dispositivos quantos quiser, e todos ficam sincronizados. Abra Definições, crie um convite e envie a ligação — quem a abrir adere a este orçamento.\n\nA ligação serve uma única vez e expira ao fim de uma semana, por isso reencaminhá-la é inofensivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один бюджет может жить на любом числе устройств, и все они остаются в согласии. Открой настройки, создай приглашение и отправь ссылку — кто её откроет, присоединится к этому бюджету.\n\nСсылка срабатывает один раз и истекает через неделю, так что переслать её не страшно."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir bütçe istediğin kadar cihazda yaşayabilir ve hepsi aynı kalır. Ayarlar'ı aç, bir davet oluştur ve bağlantıyı gönder — bağlantıyı açan bu bütçeye katılır.\n\nBağlantı bir kez çalışır ve bir hafta sonra geçersiz olur, iletilmesinin zararı yoktur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Один бюджет може жити на будь-якій кількості пристроїв, і всі вони лишаються узгодженими. Відкрий налаштування, створи запрошення й надішли посилання — хто його відкриє, приєднається до цього бюджету.\n\nПосилання спрацьовує один раз і застаріває за тиждень, тож переслати його не страшно."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một ngân sách có thể nằm trên bao nhiêu thiết bị tuỳ bạn, và tất cả luôn khớp nhau. Mở Cài đặt, tạo một lời mời rồi gửi liên kết — ai mở liên kết sẽ tham gia ngân sách này.\n\nLiên kết chỉ dùng được một lần và hết hạn sau một tuần, nên chuyển tiếp cũng không sao."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个预算可以放在任意多台设备上，而且始终保持一致。打开设置，创建一个邀请，把链接发出去——谁打开链接就会加入这个预算。\n\n链接只能用一次，一周后失效，所以被转发也没关系。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一個預算可以放在任意多台裝置上，而且始終保持一致。打開設定，建立一個邀請，把連結傳出去——誰打開連結就會加入這個預算。\n\n連結只能用一次，一週後失效，所以被轉傳也沒關係。"
          }
        }
      }
    },
    "Open Settings, create an invitation, and send the link. Whoever opens it joins this budget, and you will both see the same running total.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح الإعدادات، وأنشئ دعوة، وأرسل الرابط. من يفتحه ينضم إلى هذه الميزانية، وسترون المجموع نفسه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne die Einstellungen, erstelle eine Einladung und schick den Link. Wer ihn öffnet, tritt diesem Budget bei, und ihr seht beide dieselbe Summe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Ajustes, crea una invitación y envía el enlace. Quien lo abra se une a este presupuesto y los dos veréis el mismo total."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Ajustes, crea una invitación y manda el enlace. Quien lo abra se une a este presupuesto y los dos van a ver el mismo total."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Réglages, créez une invitation et envoyez le lien. Celui qui l'ouvre rejoint ce budget, et vous voyez tous les deux le même total."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेटिंग खोलें, न्योता बनाएँ और लिंक भेजें। जो उसे खोलेगा वह इसी बजट में जुड़ जाएगा, और दोनों को एक ही जोड़ दिखेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Pengaturan, buat undangan, lalu kirim tautannya. Siapa pun yang membukanya ikut ke anggaran ini, dan kalian berdua melihat total yang sama."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Impostazioni, crea un invito e manda il link. Chi lo apre entra in questo budget, e vedrete entrambi lo stesso totale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定を開いて招待を作り、リンクを送ってください。開いた相手はこの予算に参加し、二人とも同じ合計を見ることになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정을 열고 초대를 만든 뒤 링크를 보내세요. 링크를 연 사람이 이 예산에 참여하고, 두 사람 모두 같은 합계를 보게 돼요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Instellingen, maak een uitnodiging en stuur de link. Wie hem opent doet mee met dit budget, en jullie zien allebei hetzelfde totaal."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz Ustawienia, utwórz zaproszenie i wyślij link. Kto go otworzy, dołącza do tego budżetu, a oboje widzicie tę samą sumę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra Configurações, crie um convite e mande o link. Quem abrir entra neste orçamento, e os dois veem o mesmo total."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra Definições, crie um convite e envie a ligação. Quem a abrir adere a este orçamento, e ambos veem o mesmo total."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открой настройки, создай приглашение и отправь ссылку. Кто её откроет, присоединится к этому бюджету, и вы оба увидите один и тот же итог."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlar'ı aç, bir davet oluştur ve bağlantıyı gönder. Bağlantıyı açan bu bütçeye katılır ve ikiniz de aynı toplamı görürsünüz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрий налаштування, створи запрошення й надішли посилання. Хто його відкриє, приєднається до цього бюджету, і ви обоє бачитимете той самий підсумок."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở Cài đặt, tạo một lời mời rồi gửi liên kết. Ai mở liên kết sẽ tham gia ngân sách này, và cả hai cùng thấy một tổng số."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开设置，创建一个邀请，把链接发出去。谁打开链接就会加入这个预算，你们看到的是同一个合计。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開設定，建立一個邀請，把連結傳出去。誰打開連結就會加入這個預算，你們看到的是同一個總計。"
          }
        }
      }
    },
    "Or join one": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أو انضم إلى واحدة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Oder tritt einem bei"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "O únete a uno"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "O únete a uno"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ou rejoignez-en un"
          }
        },
        "hi": {
