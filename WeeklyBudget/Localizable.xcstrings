    "Expenses you add for this week will show up here.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المصروفات التي تضيفها لهذا الأسبوع ستظهر هنا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgaben, die du für diese Woche einträgst, erscheinen hier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los gastos que añadas esta semana aparecerán aquí."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Los gastos que agregues esta semana van a aparecer aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dépenses que vous ajoutez cette semaine apparaîtront ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस सप्ताह जोड़े गए खर्च यहाँ दिखेंगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengeluaran yang kamu tambahkan minggu ini akan muncul di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le spese che aggiungi per questa settimana compaiono qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今週に追加した支出がここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 주에 추가한 지출이 여기에 표시돼요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uitgaven die je deze week toevoegt, verschijnen hier."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wydatki dodane na ten tydzień pojawią się tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os gastos que você adicionar nesta semana aparecem aqui."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As despesas que adicionar esta semana aparecem aqui."
          }
        },
