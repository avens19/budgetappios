    "Tap a category to see its expenses.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على فئة لعرض مصروفاتها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf eine Kategorie, um ihre Ausgaben zu sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca una categoría para ver sus gastos."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca una categoría para ver sus gastos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez une catégorie pour voir ses dépenses."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी श्रेणी के खर्च देखने के लिए उस पर टैप करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk kategori untuk melihat pengeluarannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca una categoria per vederne le spese."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カテゴリをタップすると、その支出を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카테고리를 누르면 해당 지출을 볼 수 있어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op een categorie om de uitgaven te zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotknij kategorii, aby zobaczyć jej wydatki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em uma categoria para ver os gastos dela."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque numa categoria para ver as suas despesas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажми на категорию, чтобы увидеть её расходы."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Harcamalarını görmek için bir kategoriye dokun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисни на категорію, щоб побачити її витрати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm vào một danh mục để xem các khoản chi của nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按分类可以查看它的支出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下分類就能看到它的支出。"
          }
        }
      }
    },
    "That invitation has already been used, or it has expired. Ask for a new one.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه الدعوة استُخدمت من قبل أو انتهت صلاحيتها. اطلب واحدة جديدة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Einladung wurde schon benutzt oder ist abgelaufen. Frag nach einer neuen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa invitación ya se ha usado o ha caducado. Pide otra."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa invitación ya se usó o venció. Pide otra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette invitation a déjà servi, ou elle a expiré. Demandez-en une autre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वह न्योता पहले इस्तेमाल हो चुका है, या उसकी अवधि खत्म हो गई है। नया माँग लें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Undangan itu sudah dipakai, atau sudah kedaluwarsa. Minta yang baru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quell'invito è già stato usato, oppure è scaduto. Chiedine un altro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その招待はすでに使われたか、期限が切れています。新しいものをもらってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 초대는 이미 사용했거나 만료됐어요. 새로 받아 주세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Die uitnodiging is al gebruikt of verlopen. Vraag een nieuwe."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To zaproszenie zostało już użyte albo wygasło. Poproś o nowe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse convite já foi usado ou expirou. Peça outro."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse convite já foi usado ou expirou. Peça outro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это приглашение уже использовано или истекло. Попроси новое."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu davet zaten kullanılmış ya da süresi dolmuş. Yenisini iste."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це запрошення вже використали або воно застаріло. Попроси нове."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lời mời đó đã được dùng, hoặc đã hết hạn. Hãy xin một cái mới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "那个邀请已经用过，或者已经过期。再要一个吧。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "那個邀請已經用過，或是已經過期。再要一個吧。"
          }
        }
      }
    },
    "That leaves nothing to spend each week. Check the figures — or leave the steady spending out and track it here week to week instead.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بهذا لا يتبقى شيء للإنفاق كل أسبوع. راجع الأرقام — أو اترك المصروف المنتظم خارج الحساب وسجّله هنا أسبوعًا بأسبوع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So bleibt pro Woche nichts zum Ausgeben. Prüf die Zahlen — oder lass die regelmäßigen Ausgaben weg und trag sie hier Woche für Woche ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Así no queda nada para gastar cada semana. Revisa las cifras — o deja fuera el gasto estable y anótalo aquí semana a semana."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Así no queda nada para gastar cada semana. Revisa las cifras — o deja fuera el gasto estable y anótalo aquí semana a semana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ne reste alors rien à dépenser chaque semaine. Vérifiez les chiffres — ou laissez les dépenses régulières de côté et saisissez-les ici semaine après semaine."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस हिसाब से हर सप्ताह खर्च के लिए कुछ नहीं बचता। आँकड़े जाँचें — या नियमित खर्च को यहाँ से हटा दें और उन्हें हफ्ते-दर-हफ्ते यहीं दर्ज करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengan begitu tidak ada sisa untuk dibelanjakan tiap minggu. Periksa lagi angkanya — atau jangan kurangi belanja rutin di sini, catat saja minggu demi minggu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Così non resta niente da spendere ogni settimana. Controlla i numeri — oppure lascia fuori le spese regolari e segnale qui settimana per settimana."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これでは毎週使えるお金が残りません。金額を見直すか、決まった買い物はここから外して、毎週の支出として記録してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이대로면 매주 쓸 돈이 남지 않아요. 금액을 다시 확인하거나, 고정적인 생활비는 빼고 매주 지출로 기록해 보세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dan blijft er per week niets over om uit te geven. Controleer de bedragen — of laat de vaste boodschappen eruit en houd ze hier week voor week bij."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wtedy na tydzień nie zostaje nic. Sprawdź liczby — albo nie odejmuj tu stałych zakupów i zapisuj je tydzień po tygodniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Assim não sobra nada para gastar por semana. Confira os números — ou deixe o gasto estável de fora e lance semana a semana aqui."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Assim não sobra nada para gastar por semana. Confira os números — ou deixe a despesa estável de fora e registe-a aqui semana a semana."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Так на неделю не остаётся ничего. Проверь цифры — или не вычитай регулярные траты здесь, а записывай их неделя за неделей."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Böyle olunca haftada harcanacak bir şey kalmıyor. Rakamları gözden geçir — ya da düzenli alışverişi dışarıda bırak ve burada her hafta işle."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Так на тиждень не лишається нічого. Перевір цифри — або не віднімай регулярні витрати тут, а записуй їх тиждень за тижнем."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Như vậy mỗi tuần không còn gì để tiêu. Xem lại các con số — hoặc để khoản chi đều đặn ra ngoài và ghi từng tuần ở đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这样每周就没有钱可花了。检查一下数字——或者把固定的日常开销留在外面，改成每周在这里记账。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這樣每週就沒有錢可以花了。檢查一下數字——或者把固定的日常開銷留在外面，改成每週在這裡記帳。"
          }
        }
      }
    },
    "The amounts that go out whether you think about them or not. Savings belongs here too: money you have decided not to spend is not spending money.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المبالغ التي تخرج سواء فكرت فيها أم لا. الادخار هنا أيضًا: المال الذي قررت ألا تنفقه ليس مالًا للإنفاق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Beträge, die abgehen, ob du an sie denkst oder nicht. Sparen gehört auch hierher: Geld, das du nicht ausgeben willst, ist kein Geld zum Ausgeben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las cantidades que salen pienses en ellas o no. El ahorro también va aquí: el dinero que has decidido no gastar no es dinero para gastos."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Los montos que salen pienses en ellos o no. El ahorro también va aquí: el dinero que decidiste no gastar no es dinero para gastos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les montants qui partent que vous y pensiez ou non. L'épargne compte ici aussi : l'argent que vous avez décidé de ne pas dépenser n'est pas de l'argent à dépenser."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वे रकमें जो आपके सोचे बिना भी निकल जाती हैं। बचत भी यहीं आती है: जो पैसा आपने न खर्च करने का तय किया, वह खर्च का पैसा नहीं है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jumlah yang keluar entah kamu memikirkannya atau tidak. Tabungan juga masuk sini: uang yang sudah kamu putuskan untuk tidak dibelanjakan bukan uang belanja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli importi che escono che tu ci pensi o no. Anche il risparmio va qui: i soldi che hai deciso di non spendere non sono soldi da spendere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "意識しなくても出ていく金額です。貯金もここに入ります。使わないと決めたお金は、使えるお金ではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신경 쓰지 않아도 빠져나가는 금액이에요. 저축도 여기예요. 쓰지 않기로 정한 돈은 쓸 수 있는 돈이 아니니까요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De bedragen die eraf gaan of je er nu aan denkt of niet. Sparen hoort hier ook: geld dat je besloten hebt niet uit te geven is geen vrij besteedbaar geld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kwoty, które schodzą z konta, czy o nich myślisz, czy nie. Oszczędności też tutaj: pieniądze, których postanowiłeś nie wydawać, nie są pieniędzmi na wydatki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os valores que saem quer você pense neles ou não. Poupança entra aqui também: dinheiro que você decidiu não gastar não é dinheiro livre."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os montantes que saem quer pense neles quer não. A poupança entra aqui também: dinheiro que decidiu não gastar não é dinheiro para gastar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Суммы, которые уходят, думаешь ты о них или нет. Накопления тоже сюда: деньги, которые ты решил не тратить, — не деньги на траты."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sen düşünsen de düşünmesen de çıkan tutarlar. Birikim de buraya girer: harcamamaya karar verdiğin para, harcama parası değildir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Суми, які йдуть, думаєш ти про них чи ні. Заощадження теж сюди: гроші, які ти вирішив не витрачати, — не гроші на витрати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những số tiền ra đi dù bạn có nghĩ tới hay không. Tiết kiệm cũng ở đây: tiền bạn đã quyết định không tiêu thì không phải tiền để tiêu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不管你想不想它们，都会扣掉的金额。存钱也算在这里：你决定不花的钱，就不是可以花的钱。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不管你想不想它們，都會扣掉的金額。存錢也算在這裡：你決定不花的錢，就不是可以花的錢。"
          }
        }
      }
    },
    "The budget itself is not deleted. Anyone else using it keeps it, and you can join again with the ID.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الميزانية نفسها لا تُحذف. من يستخدمها غيرك يحتفظ بها، ويمكنك الانضمام مجددًا بالمعرّف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Budget selbst wird nicht gelöscht. Wer es sonst benutzt, behält es, und du kannst mit der ID wieder beitreten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El presupuesto en sí no se elimina. Quien más lo use lo conserva, y puedes volver a unirte con el ID."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "El presupuesto en sí no se elimina. Quien más lo use lo conserva, y puedes volver a unirte con el ID."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le budget lui-même n'est pas supprimé. Ceux qui l'utilisent le gardent, et vous pouvez le rejoindre à nouveau avec l'ID."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बजट खुद नहीं मिटता। जो और लोग इसे इस्तेमाल कर रहे हैं उनके पास रहता है, और आप ID से फिर जुड़ सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anggarannya sendiri tidak dihapus. Orang lain yang memakainya tetap punya, dan kamu bisa gabung lagi dengan ID-nya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il budget in sé non viene eliminato. Chi altro lo usa lo mantiene, e puoi rientrare con l'ID."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予算そのものは削除されません。ほかに使っている人はそのまま使えますし、IDでいつでも参加し直せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예산 자체가 삭제되지는 않아요. 함께 쓰는 사람은 그대로 쓰고, ID로 다시 참여할 수 있어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het budget zelf wordt niet verwijderd. Wie het verder gebruikt houdt het, en met het ID kun je opnieuw meedoen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sam budżet nie zostaje usunięty. Kto inny z niego korzysta, ten go zachowuje, a ty możesz dołączyć ponownie przez ID."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O orçamento em si não é excluído. Quem mais usa continua com ele, e você pode entrar de novo com o ID."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O orçamento em si não é eliminado. Quem mais o usa mantém-no, e pode aderir de novo com o ID."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сам бюджет не удаляется. У тех, кто им пользуется, он остаётся, а ты можешь снова присоединиться по ID."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bütçenin kendisi silinmez. Kullanan başkaları varsa onlarda kalır, sen de ID ile yeniden katılabilirsin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сам бюджет не видаляється. У тих, хто ним користується, він лишається, а ти можеш знову приєднатися за ID."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản thân ngân sách không bị xoá. Người khác đang dùng vẫn giữ được, và bạn có thể tham gia lại bằng ID."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预算本身不会被删除。还在用它的人照旧，你也可以用 ID 重新加入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預算本身不會被刪除。還在用它的人照舊，你也可以用 ID 重新加入。"
          }
        }
      }
    },
    "The link works once and expires after a week, so a forwarded one is harmless.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الرابط يعمل مرة واحدة وتنتهي صلاحيته بعد أسبوع، فإعادة إرساله غير ضارة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Link gilt einmal und läuft nach einer Woche ab, weitergeleitet richtet er also keinen Schaden an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El enlace funciona una sola vez y caduca en una semana, así que reenviarlo es inofensivo."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "El enlace sirve una sola vez y vence en una semana, así que reenviarlo no hace daño."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le lien ne sert qu'une fois et expire au bout d'une semaine : le transférer est sans risque."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लिंक एक ही बार चलता है और एक हफ्ते में खत्म हो जाता है, इसलिए आगे भेजने में कोई नुकसान नहीं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tautan hanya berlaku sekali dan kedaluwarsa setelah seminggu, jadi kalau diteruskan pun tidak masalah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il link vale una volta sola e scade dopo una settimana, quindi inoltrarlo non fa danni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクは1回だけ有効で1週間で失効するので、転送されても問題ありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링크는 한 번만 쓸 수 있고 일주일 뒤 만료되니 전달돼도 괜찮아요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De link werkt één keer en verloopt na een week, dus doorsturen kan geen kwaad."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Link działa raz i wygasa po tygodniu, więc przesłanie go dalej nic nie psuje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O link funciona uma vez só e expira em uma semana, então repassá-lo não faz mal."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A ligação serve uma única vez e expira ao fim de uma semana, por isso reencaminhá-la é inofensivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ссылка срабатывает один раз и истекает через неделю, так что переслать её не страшно."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı bir kez çalışır ve bir hafta sonra geçersiz olur, iletilmesinin zararı yoktur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Посилання спрацьовує один раз і застаріває за тиждень, тож переслати його не страшно."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liên kết chỉ dùng được một lần và hết hạn sau một tuần, nên chuyển tiếp cũng không sao."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "链接只能用一次，一周后失效，所以被转发也没关系。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連結只能用一次，一週後失效，所以被轉傳也沒關係。"
          }
        }
      }
    },
    "The older way. Enter this ID on another device — another phone, or the web app — to use the same budget. It does not expire, so treat it like a password.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الطريقة الأقدم. أدخل هذا المعرّف على جهاز آخر — هاتف آخر أو تطبيق الويب — لاستخدام الميزانية نفسها. لا تنتهي صلاحيته، فتعامل معه ككلمة مرور."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der alte Weg. Gib diese ID auf einem anderen Gerät ein — einem anderen Handy oder der Web-App — um dasselbe Budget zu benutzen. Sie läuft nie ab, also behandle sie wie ein Passwort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La forma antigua. Introduce este ID en otro dispositivo — otro móvil o la app web — para usar el mismo presupuesto. No caduca, así que trátalo como una contraseña."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La forma antigua. Pon este ID en otro dispositivo — otro celular o la app web — para usar el mismo presupuesto. No vence, así que trátalo como una contraseña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'ancienne méthode. Saisissez cet ID sur un autre appareil — un autre téléphone, ou l'appli web — pour utiliser le même budget. Il n'expire pas : traitez-le comme un mot de passe."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पुराना तरीका। वही बजट इस्तेमाल करने के लिए यह ID किसी और डिवाइस — दूसरे फ़ोन या वेब ऐप — में डालें। यह कभी खत्म नहीं होती, इसलिए इसे पासवर्ड की तरह रखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cara lama. Masukkan ID ini di perangkat lain — ponsel lain, atau aplikasi web — untuk memakai anggaran yang sama. ID ini tidak pernah kedaluwarsa, jadi perlakukan seperti kata sandi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il modo vecchio. Inserisci questo ID su un altro dispositivo — un altro telefono, o l'app web — per usare lo stesso budget. Non scade, quindi trattalo come una password."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前からの方法です。同じ予算を使うには、このIDを別の端末（ほかのスマホ、またはウェブ版）に入力してください。失効しないので、パスワードのように扱ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예전 방식이에요. 같은 예산을 쓰려면 이 ID를 다른 기기 — 다른 휴대폰이나 웹 앱 — 에 입력하세요. 만료되지 않으니 비밀번호처럼 다뤄 주세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De oude manier. Voer dit ID in op een ander apparaat — een andere telefoon, of de web-app — om hetzelfde budget te gebruiken. Het verloopt niet, dus behandel het als een wachtwoord."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Starszy sposób. Wpisz to ID na innym urządzeniu — innym telefonie albo w aplikacji webowej — żeby korzystać z tego samego budżetu. Nie wygasa, więc traktuj je jak hasło."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O jeito antigo. Digite este ID em outro dispositivo — outro celular, ou o app web — para usar o mesmo orçamento. Ele não expira, então trate como uma senha."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A forma antiga. Introduza este ID noutro dispositivo — outro telemóvel, ou a app web — para usar o mesmo orçamento. Não expira, por isso trate-o como uma palavra-passe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Старый способ. Введи этот ID на другом устройстве — другом телефоне или в веб-приложении — чтобы вести тот же бюджет. Он не истекает, так что относись к нему как к паролю."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eski yöntem. Aynı bütçeyi kullanmak için bu ID'yi başka bir cihaza — başka bir telefona ya da web uygulamasına — gir. Süresi hiç dolmaz, o yüzden onu bir parola gibi sakla."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Старий спосіб. Введи цей ID на іншому пристрої — іншому телефоні або у вебзастосунку — щоб вести той самий бюджет. Він не застаріває, тож ставься до нього як до пароля."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cách cũ. Nhập ID này trên thiết bị khác — điện thoại khác, hoặc bản web — để dùng cùng ngân sách. Nó không hết hạn, nên hãy coi như mật khẩu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "旧办法。在另一台设备——另一部手机，或者网页版——输入这个 ID，就能用同一个预算。它永不过期，所以请把它当成密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "舊方法。在另一台裝置——另一支手機，或是網頁版——輸入這個 ID，就能用同一個預算。它永遠不會過期，所以請把它當成密碼。"
          }
        }
      }
    },
    "The same budget opens on other phones and at budget.andrewovens.com, with the same expenses and the same total.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الميزانية نفسها تُفتح على هواتف أخرى وعلى budget.andrewovens.com، بالمصروفات نفسها والمجموع نفسه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dasselbe Budget öffnet sich auf anderen Handys und unter budget.andrewovens.com, mit denselben Ausgaben und derselben Summe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mismo presupuesto se abre en otros móviles y en budget.andrewovens.com, con los mismos gastos y el mismo total."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "El mismo presupuesto se abre en otros celulares y en budget.andrewovens.com, con los mismos gastos y el mismo total."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le même budget s'ouvre sur d'autres téléphones et sur budget.andrewovens.com, avec les mêmes dépenses et le même total."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यही बजट दूसरे फ़ोन पर और budget.andrewovens.com पर खुलता है — वही खर्च, वही जोड़।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anggaran yang sama terbuka di ponsel lain dan di budget.andrewovens.com, dengan pengeluaran dan total yang sama."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo stesso budget si apre su altri telefoni e su budget.andrewovens.com, con le stesse spese e lo stesso totale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ予算がほかのスマホでも budget.andrewovens.com でも開けます。支出も合計も同じです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 예산이 다른 휴대폰에서도, budget.andrewovens.com에서도 열려요. 지출도 합계도 같아요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hetzelfde budget opent op andere telefoons en op budget.andrewovens.com, met dezelfde uitgaven en hetzelfde totaal."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten sam budżet otwiera się na innych telefonach i na budget.andrewovens.com — te same wydatki, ta sama suma."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O mesmo orçamento abre em outros celulares e em budget.andrewovens.com, com os mesmos gastos e o mesmo total."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O mesmo orçamento abre noutros telemóveis e em budget.andrewovens.com, com as mesmas despesas e o mesmo total."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тот же бюджет открывается на других телефонах и на budget.andrewovens.com — те же расходы, тот же итог."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynı bütçe diğer telefonlarda ve budget.andrewovens.com adresinde açılıyor; aynı harcamalar, aynı toplam."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Той самий бюджет відкривається на інших телефонах і на budget.andrewovens.com — ті самі витрати, той самий підсумок."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cùng một ngân sách mở được trên điện thoại khác và tại budget.andrewovens.com, với cùng khoản chi và cùng tổng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同一个预算在其他手机上和 budget.andrewovens.com 都能打开，支出和合计都一样。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同一個預算在其他手機上和 budget.andrewovens.com 都能打開，支出和總計都一樣。"
          }
        }
      }
    },
    "There is deliberately nowhere to enter recurring income or expenses. Those amounts are already fixed, so leaving them out keeps the app focused on the one number that actually moves: what you spent this week.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد هنا عمدًا مكان لإدخال دخل أو مصروف متكرر. تلك المبالغ محددة أصلًا، وتركها خارجًا يُبقي التطبيق على الرقم الوحيد الذي يتحرك فعلًا: كم أنفقت هذا الأسبوع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt bewusst keine Stelle für wiederkehrende Einnahmen oder Ausgaben. Diese Beträge stehen ohnehin fest, und ohne sie bleibt die App bei der einen Zahl, die sich wirklich bewegt: was du diese Woche ausgegeben hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A propósito no hay ningún sitio para introducir ingresos o gastos recurrentes. Esas cantidades ya están fijadas, así que dejarlas fuera mantiene la app centrada en el único número que se mueve de verdad: lo que has gastado esta semana."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "A propósito no hay dónde anotar ingresos ni gastos recurrentes. Esos montos ya están fijos, así que dejarlos fuera mantiene la app centrada en el único número que de verdad se mueve: lo que gastaste esta semana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'y a volontairement aucun endroit pour saisir des revenus ou des dépenses récurrents. Ces montants sont déjà fixés : les laisser de côté garde l'appli concentrée sur le seul chiffre qui bouge vraiment, ce que vous avez dépensé cette semaine."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर महीने आने वाली आय या खर्च दर्ज करने की जगह जान-बूझकर नहीं रखी गई। वे रकमें पहले से तय हैं, और उन्हें बाहर रखने से ऐप उसी एक संख्या पर टिका रहता है जो सचमुच बदलती है: इस हफ्ते आपने कितना खर्च किया।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memang sengaja tidak ada tempat untuk mencatat pemasukan atau pengeluaran rutin. Jumlahnya sudah pasti, jadi dengan meninggalkannya di luar, aplikasi tetap fokus pada satu angka yang benar-benar bergerak: berapa yang kamu habiskan minggu ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Di proposito non c'è nessun posto dove inserire entrate o spese ricorrenti. Quegli importi sono già fissati, quindi lasciarli fuori tiene l'app concentrata sull'unico numero che si muove davvero: quanto hai speso questa settimana."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎月決まった収入や支出を入れる場所は、あえて用意していません。金額がすでに決まっているものを外しておけば、本当に動く数字――今週いくら使ったか――だけに集中できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정기 수입이나 정기 지출을 넣는 곳은 일부러 두지 않았어요. 이미 정해진 금액이라 빼두면, 앱은 실제로 움직이는 하나의 숫자 — 이번 주에 얼마를 썼는지 — 에만 집중할 수 있어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is met opzet nergens plek voor terugkerende inkomsten of uitgaven. Die bedragen liggen toch al vast, en ze weglaten houdt de app bij het enige getal dat echt beweegt: wat je deze week hebt uitgegeven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Celowo nie ma tu miejsca na stałe przychody ani wydatki. Te kwoty i tak są ustalone, a bez nich aplikacja pilnuje jedynej liczby, która naprawdę się rusza: ile wydałeś w tym tygodniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "De propósito, não há onde lançar receitas ou gastos recorrentes. Esses valores já estão definidos, então deixá-los de fora mantém o app focado no único número que realmente muda: o que você gastou esta semana."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "De propósito, não há onde registar receitas ou despesas recorrentes. Esses montantes já estão fixados, por isso deixá-los de fora mantém a app centrada no único número que se mexe mesmo: o que gastou esta semana."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь намеренно негде вводить регулярные доходы и расходы. Эти суммы и так известны, а без них приложение остаётся о единственном числе, которое действительно меняется: сколько вы потратили на этой неделе."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düzenli gelir ya da gideri girecek bir yer bilerek yok. O tutarlar zaten belli; dışarıda bırakınca uygulama gerçekten değişen tek sayıya odaklanıyor: bu hafta ne harcadığın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут навмисно немає де вводити регулярні доходи й витрати. Ці суми й так відомі, а без них застосунок лишається про єдине число, яке справді змінюється: скільки ви витратили цього тижня."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng cố ý không có chỗ nhập thu nhập hay chi phí định kỳ. Những con số đó đã cố định rồi, để chúng ra ngoài thì ứng dụng chỉ tập trung vào con số thật sự thay đổi: tuần này bạn đã tiêu bao nhiêu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里刻意没有记录固定收入和固定支出的地方。那些数字本来就定好了，把它们排除在外，应用才能只盯着真正会变的那一个数字：你这周花了多少。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這裡刻意沒有記錄固定收入和固定支出的地方。那些數字本來就定好了，把它們排除在外，應用程式才能只盯著真正會變的那個數字：你這週花了多少。"
          }
        }
      }
    },
    "There is deliberately nowhere to enter recurring income or expenses. Those amounts are already fixed, so leaving them out keeps the app focused on the one number that actually moves: what you spent this week.\n\nIf money comes in mid-week — a refund, a gift, cash back — add it as an expense with a minus sign.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد هنا عمدًا مكان لإدخال دخل أو مصروف متكرر. تلك المبالغ محددة أصلًا، وتركها خارجًا يُبقي التطبيق على الرقم الوحيد الذي يتحرك فعلًا: كم أنفقت هذا الأسبوع.\n\nإذا دخل مال في منتصف الأسبوع — استرداد أو هدية أو استرجاع نقدي — أضفه كمصروف بإشارة سالبة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt bewusst keine Stelle für wiederkehrende Einnahmen oder Ausgaben. Diese Beträge stehen ohnehin fest, und ohne sie bleibt die App bei der einen Zahl, die sich wirklich bewegt: was du diese Woche ausgegeben hast.\n\nKommt mitten in der Woche Geld rein — eine Erstattung, ein Geschenk, ein Cashback — trag es als Ausgabe mit Minuszeichen ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A propósito no hay ningún sitio para introducir ingresos o gastos recurrentes. Esas cantidades ya están fijadas, así que dejarlas fuera mantiene la app centrada en el único número que se mueve de verdad: lo que has gastado esta semana.\n\nSi entra dinero a mitad de semana — una devolución, un regalo, un reembolso — añádelo como un gasto con signo menos."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "A propósito no hay dónde anotar ingresos ni gastos recurrentes. Esos montos ya están fijos, así que dejarlos fuera mantiene la app centrada en el único número que de verdad se mueve: lo que gastaste esta semana.\n\nSi entra dinero a mitad de semana — un reembolso, un regalo, un cashback — agrégalo como gasto con signo menos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'y a volontairement aucun endroit pour saisir des revenus ou des dépenses récurrents. Ces montants sont déjà fixés : les laisser de côté garde l'appli concentrée sur le seul chiffre qui bouge vraiment, ce que vous avez dépensé cette semaine.\n\nSi de l'argent rentre en milieu de semaine — un remboursement, un cadeau, un cashback — saisissez-le comme une dépense avec un signe moins."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर महीने आने वाली आय या खर्च दर्ज करने की जगह जान-बूझकर नहीं रखी गई। वे रकमें पहले से तय हैं, और उन्हें बाहर रखने से ऐप उसी एक संख्या पर टिका रहता है जो सचमुच बदलती है: इस हफ्ते आपने कितना खर्च किया।\n\nअगर हफ्ते के बीच पैसा आए — रिफंड, तोहफा, कैशबैक — तो उसे माइनस के निशान के साथ खर्च की तरह जोड़ें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memang sengaja tidak ada tempat untuk mencatat pemasukan atau pengeluaran rutin. Jumlahnya sudah pasti, jadi dengan meninggalkannya di luar, aplikasi tetap fokus pada satu angka yang benar-benar bergerak: berapa yang kamu habiskan minggu ini.\n\nKalau ada uang masuk di tengah minggu — refund, hadiah, cashback — catat sebagai pengeluaran dengan tanda minus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Di proposito non c'è nessun posto dove inserire entrate o spese ricorrenti. Quegli importi sono già fissati, quindi lasciarli fuori tiene l'app concentrata sull'unico numero che si muove davvero: quanto hai speso questa settimana.\n\nSe a metà settimana entrano soldi — un rimborso, un regalo, un cashback — inseriscili come spesa con il segno meno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎月決まった収入や支出を入れる場所は、あえて用意していません。金額がすでに決まっているものを外しておけば、本当に動く数字――今週いくら使ったか――だけに集中できます。\n\n週の途中でお金が入ったとき（返金、贈り物、キャッシュバックなど）は、マイナスの支出として追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정기 수입이나 정기 지출을 넣는 곳은 일부러 두지 않았어요. 이미 정해진 금액이라 빼두면, 앱은 실제로 움직이는 하나의 숫자 — 이번 주에 얼마를 썼는지 — 에만 집중할 수 있어요.\n\n주중에 돈이 들어오면(환불, 선물, 캐시백) 마이너스 지출로 추가하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is met opzet nergens plek voor terugkerende inkomsten of uitgaven. Die bedragen liggen toch al vast, en ze weglaten houdt de app bij het enige getal dat echt beweegt: wat je deze week hebt uitgegeven.\n\nKomt er halverwege de week geld binnen — een terugbetaling, een cadeau, cashback — voer het dan in als uitgave met een minteken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Celowo nie ma tu miejsca na stałe przychody ani wydatki. Te kwoty i tak są ustalone, a bez nich aplikacja pilnuje jedynej liczby, która naprawdę się rusza: ile wydałeś w tym tygodniu.\n\nJeśli w środku tygodnia wpadną pieniądze — zwrot, prezent, cashback — dodaj je jako wydatek ze znakiem minus."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "De propósito, não há onde lançar receitas ou gastos recorrentes. Esses valores já estão definidos, então deixá-los de fora mantém o app focado no único número que realmente muda: o que você gastou esta semana.\n\nSe entrar dinheiro no meio da semana — um estorno, um presente, um cashback — lance como gasto com sinal de menos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "De propósito, não há onde registar receitas ou despesas recorrentes. Esses montantes já estão fixados, por isso deixá-los de fora mantém a app centrada no único número que se mexe mesmo: o que gastou esta semana.\n\nSe entrar dinheiro a meio da semana — um reembolso, uma prenda, um estorno — registe-o como despesa com sinal menos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь намеренно негде вводить регулярные доходы и расходы. Эти суммы и так известны, а без них приложение остаётся о единственном числе, которое действительно меняется: сколько ты потратил на этой неделе.\n\nЕсли деньги приходят посреди недели — возврат, подарок, кешбэк — добавь их как расход со знаком минус."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düzenli gelir ya da gideri girecek bir yer bilerek yok. O tutarlar zaten belli; dışarıda bırakınca uygulama gerçekten değişen tek sayıya odaklanıyor: bu hafta ne harcadığın.\n\nHafta ortasında para girerse — iade, hediye, nakit puan — eksi işaretiyle harcama olarak ekle."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут навмисно немає де вводити регулярні доходи й витрати. Ці суми й так відомі, а без них застосунок лишається про єдине число, яке справді змінюється: скільки ти витратив цього тижня.\n\nЯкщо гроші надходять посеред тижня — повернення, подарунок, кешбек — додай їх як витрату зі знаком мінус."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng cố ý không có chỗ nhập thu nhập hay chi phí định kỳ. Những con số đó đã cố định rồi, để chúng ra ngoài thì ứng dụng chỉ tập trung vào con số thật sự thay đổi: tuần này bạn đã tiêu bao nhiêu.\n\nNếu giữa tuần có tiền vào — hoàn tiền, quà, hoàn lại — hãy ghi thành khoản chi với dấu trừ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里刻意没有记录固定收入和固定支出的地方。那些数字本来就定好了，把它们排除在外，应用才能只盯着真正会变的那一个数字：你这周花了多少。\n\n如果周中有钱进来——退款、红包、返现——就用负数记成一笔支出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這裡刻意沒有記錄固定收入和固定支出的地方。那些數字本來就定好了，把它們排除在外，應用程式才能只盯著真正會變的那個數字：你這週花了多少。\n\n如果週間有錢進來——退款、紅包、回饋——就用負數記成一筆支出。"
          }
        }
      }
    },
    "Things that vary a little but never surprise you. Subtract them here and they stay out of the app; leave them blank and enter them week to week instead. One or the other, not both.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أشياء تتغير قليلًا لكنها لا تفاجئك أبدًا. اطرحها هنا فتبقى خارج التطبيق، أو اتركها فارغة وسجّلها أسبوعًا بأسبوع. أحد الأمرين، لا كلاهما."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dinge, die etwas schwanken, dich aber nie überraschen. Zieh sie hier ab, dann bleiben sie aus der App heraus; lass sie leer und trag sie Woche für Woche ein. Das eine oder das andere, nicht beides."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosas que varían un poco pero nunca te sorprenden. Réstalas aquí y se quedan fuera de la app; déjalas en blanco y anótalas semana a semana. Una cosa o la otra, no las dos."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosas que varían un poco pero nunca te sorprenden. Réstalas aquí y se quedan fuera de la app; déjalas en blanco y anótalas semana a semana. Una cosa o la otra, no las dos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui varie un peu mais ne vous surprend jamais. Retirez-les ici et elles restent hors de l'appli ; laissez-les vides et saisissez-les semaine après semaine. L'un ou l'autre, pas les deux."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जो थोड़ा घटता-बढ़ता है पर कभी चौंकाता नहीं। इन्हें यहाँ घटा दें तो ये ऐप से बाहर रहेंगे; खाली छोड़ दें तो हफ्ते-दर-हफ्ते यहीं दर्ज करें। दोनों में से एक, दोनों नहीं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hal-hal yang naik turun sedikit tapi tidak pernah mengejutkan. Kurangi di sini dan mereka tidak masuk aplikasi; biarkan kosong dan catat minggu demi minggu. Pilih salah satu, jangan dua-duanya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cose che variano un po' ma non ti sorprendono mai. Toglile qui e restano fuori dall'app; lasciale vuote e segnale settimana per settimana. O l'una o l'altra, non tutte e due."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "多少は増減しても、驚くことはない支出です。ここで引けばアプリの外に置けますし、空欄にすれば毎週の支出として記録できます。どちらか一方にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조금씩 달라지지만 놀랄 일은 없는 지출이에요. 여기서 빼면 앱 밖에 두는 것이고, 비워 두면 매주 기록하게 돼요. 둘 중 하나만 하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dingen die iets schommelen maar je nooit verrassen. Trek ze hier af en ze blijven buiten de app; laat ze leeg en voer ze week voor week in. Het een of het ander, niet allebei."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rzeczy, które trochę się wahają, ale nigdy nie zaskakują. Odejmij je tutaj, a zostaną poza aplikacją; zostaw puste i zapisuj je tydzień po tygodniu. Jedno albo drugie, nie oba naraz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coisas que variam um pouco mas nunca surpreendem. Subtraia aqui e elas ficam fora do app; deixe em branco e lance semana a semana. Uma coisa ou outra, não as duas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Coisas que variam um pouco mas nunca o surpreendem. Subtraia-as aqui e ficam fora da app; deixe-as em branco e registe-as semana a semana. Uma coisa ou outra, não as duas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "То, что немного меняется, но никогда не удивляет. Вычти их здесь — и они останутся вне приложения; оставь пустыми — и записывай их неделя за неделей. Одно или другое, но не оба сразу."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Biraz değişen ama seni asla şaşırtmayan şeyler. Burada çıkarırsan uygulamanın dışında kalırlar; boş bırakırsan her hafta buraya işlersin. Biri ya da öteki, ikisi birden değil."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Те, що трохи змінюється, але ніколи не дивує. Відніми їх тут — і вони лишаться поза застосунком; залиш порожніми — і записуй їх тиждень за тижнем. Одне або інше, але не разом."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những thứ nhích lên nhích xuống một chút nhưng không bao giờ làm bạn bất ngờ. Trừ ở đây thì chúng nằm ngoài ứng dụng; để trống thì ghi từng tuần. Chọn một trong hai, đừng làm cả hai."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有点浮动但从不让你意外的开销。在这里减掉，它们就不进应用；留空的话就每周在应用里记。二选一，别两边都算。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "會小幅變動但從不讓你意外的開銷。在這裡扣掉，它們就不進應用程式；留空的話就每週在應用程式裡記。二選一，別兩邊都算。"
          }
        }
      }
    },
