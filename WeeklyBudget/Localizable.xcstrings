    "You are now sharing %@. It will fill in as it syncs.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت الآن تشارك %1$@. ستمتلئ البيانات مع المزامنة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du teilst jetzt %1$@. Es füllt sich, sobald synchronisiert wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya compartes %1$@. Se irá llenando conforme se sincronice."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya compartes %1$@. Se va a ir llenando conforme se sincronice."
          }
        },
        "fr": {
          "stringUnit": {
