        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu haftaya eklediğin harcamalar burada görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Витрати, які ти додаси цього тижня, з'являться тут."
