          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अब आप %1$@ साझा कर रहे हैं। सिंक होते ही यह भर जाएगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu sekarang berbagi %1$@. Isinya akan muncul begitu tersinkron."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ora condividi %1$@. Si riempirà man mano che si sincronizza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@を共有しました。同期が進むと中身が入ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 %1$@을(를) 함께 써요. 동기화되면서 내용이 채워져요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je deelt nu %1$@. Het vult zich zodra er gesynchroniseerd is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Współdzielisz teraz %1$@. Zawartość pojawi się po synchronizacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
