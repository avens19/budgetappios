    "Fill in what you can. The number updates as you type.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "املأ ما تستطيع. الرقم يتغير أثناء الكتابة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füll aus, was du kannst. Die Zahl aktualisiert sich beim Tippen."
          }
        },
        "es": {
